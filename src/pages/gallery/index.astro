---
// src/pages/gallery/index.astro
import Layout from '../../layouts/Layout.astro';

const GALLERY_API_KEY = import.meta.env.NOTION_GALLERY_API_KEY;
const GALLERY_DB_ID = import.meta.env.NOTION_GALLERY_DB_ID;

const response = await fetch(`https://api.notion.com/v1/databases/${GALLERY_DB_ID}/query`, {
  method: 'POST', 
  headers: { 
    'Authorization': `Bearer ${GALLERY_API_KEY}`, 
    'Notion-Version': '2022-06-28', 
    'Content-Type': 'application/json' 
  },
  body: JSON.stringify({ sorts: [{ property: 'Date', direction: 'descending' }] })
});

const data = await response.json();

if (!response.ok || !data.results) {
  console.error("🚨 Notion API 请求异常 | 状态码:", response.status);
}

const photoMap = {};

(data.results || []).forEach((page) => {
  const rawSlug = page.properties.Slug?.rich_text[0]?.plain_text || 'untitled';
  const groupKey = rawSlug.replace(/-?\d+$/, ''); 
  if (!photoMap[groupKey]) {
    const rawTitle = page.properties.Title?.title[0]?.plain_text || '未命名';
    photoMap[groupKey] = {
      groupKey, 
      title: rawTitle.split('-')[0], 
      category: page.properties.Category?.select?.name || '未分类',
      location: page.properties.Location?.rich_text[0]?.plain_text || '', 
      date: page.properties.Date?.date?.start || '', 
      coverImage: page.properties.ImageURL?.url || '', 
      count: 0 
    };
  }
  photoMap[groupKey].count += 1;
});

let collections = Object.values(photoMap).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
let totalPhotos = collections.reduce((acc, c) => acc + c.count, 0);
const catStats = collections.reduce((acc, c) => { acc[c.category] = (acc[c.category] || 0) + c.count; return acc; }, {});
const categories = Object.keys(catStats).map(cat => ({ name: cat, photoCount: catStats[cat] }));
---

<Layout title="生活视觉切片 | Gallery">
  
  <nav class="sticky top-0 z-50 w-full bg-white/70 dark:bg-stone-900/70 backdrop-blur-md border-b border-stone-200/50 dark:border-stone-800/50 transition-colors duration-500">
    <div class="max-w-7xl mx-auto px-6 md:px-12 h-12 flex items-center justify-between text-xs tracking-[0.2em] uppercase font-sans">
      
      {/* 左侧：纯粹的返回动作 */}
      <button id="back-btn" class="text-stone-950 dark:text-white hover:opacity-50 transition-opacity z-50 flex items-center" aria-label="返回上一页">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </button>

      {/* 桌面端常规导航项：已移除随笔碎片 */}
      <div class="hidden md:flex items-center gap-8 text-stone-500 dark:text-stone-400">
        <a href="/" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">首页</a>
        <a href="/resume" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">个人信息</a>
        <a href="/projects" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">实验项目</a>
        <a href="/gallery" class="text-stone-900 dark:text-stone-100 font-medium">视觉切片</a>
        <a href="/thanks" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">感谢</a>
      </div>

      {/* 移动端错位双线汉堡纽 */}
      <button id="menu-toggle" class="md:hidden flex flex-col justify-center items-center w-8 h-8 z-50 focus:outline-none" aria-label="Toggle Menu">
        <span class="nav-line w-4 h-[1px] bg-stone-900 dark:bg-stone-100 transition-transform duration-300 ease-out origin-center" style="transform: translateY(-2px) rotate(0deg);"></span>
        <span class="nav-line w-4 h-[1px] bg-stone-900 dark:bg-stone-100 transition-transform duration-300 ease-out origin-center" style="transform: translateY(2px) rotate(0deg);"></span>
      </button>
    </div>
  </nav>

  {/* 移动端全屏菜单：已移除随笔碎片 */}
  <div id="mobile-menu" class="fixed inset-0 bg-white/95 dark:bg-stone-950/95 backdrop-blur-xl z-40 md:hidden flex flex-col pt-24 px-8 gap-6 text-sm tracking-[0.25em] uppercase transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] opacity-0 pointer-events-none -translate-y-4">
    <a href="/" class="mobile-nav-link text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-all duration-300 transform translate-y-4 opacity-0">首页</a>
    <a href="/resume" class="mobile-nav-link text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-all duration-300 transform translate-y-4 opacity-0">个人信息</a>
    <a href="/projects" class="mobile-nav-link text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-all duration-300 transform translate-y-4 opacity-0">实验项目</a>
    <a href="/gallery" class="mobile-nav-link text-stone-950 dark:text-white font-medium border-b border-stone-900 dark:border-stone-100 pb-1 self-start transform translate-y-4 opacity-0">视觉切片</a>
    <a href="/thanks" class="mobile-nav-link text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-all duration-300 transform translate-y-4 opacity-0">感谢</a>
  </div>

  <main class="min-h-screen text-stone-900 dark:text-stone-100 py-16 md:py-24 px-6 md:px-12 max-w-7xl mx-auto font-sans transition-colors duration-500">
    <header class="mb-8 md:mb-16 max-w-3xl">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif tracking-[0.15em] text-stone-900 dark:text-stone-100 mb-6 font-light uppercase whitespace-nowrap">Visual Diary</h1>
      <p class="text-xs font-sans text-stone-500 dark:text-stone-400 tracking-[0.3em] uppercase mb-12 md:mb-16">— 生活视觉切片 · Moments & Archive</p>
      
      <div class="relative flex flex-wrap gap-2 md:gap-4 text-sm tracking-widest uppercase items-center" id="filter-container">
        <div id="active-slider" class="absolute top-0 left-0 bg-stone-200/50 dark:bg-stone-800/60 backdrop-blur-md border border-white/60 dark:border-white/10 rounded-lg shadow-sm pointer-events-none opacity-0 transition-all duration-[600ms] ease-[cubic-bezier(0.23,1,0.32,1)]" style="width: 0px; height: 0px; transform: translate(0px, 0px);"></div>

        <button class="filter-btn relative z-10 px-4 py-2 text-stone-900 dark:text-stone-100 transition-colors duration-300" data-target="all" data-active="true">
          全部 ({totalPhotos})
        </button>
        {categories.map((cat) => (
          <button class="filter-btn relative z-10 px-4 py-2 text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 transition-colors duration-300" data-target={cat.name} data-active="false">
            {cat.name} ({cat.photoCount})
          </button>
        ))}
      </div>
    </header>

    <div class="space-y-12 md:space-y-20" id="gallery-container">
      {collections.map((collection) => (
        <article class="collection-item reveal-item" data-category={collection.category}>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start">
            <div class="md:col-span-3 lg:col-span-2 pt-2 md:text-right md:pr-4 border-b md:border-b-0 md:border-r border-stone-200 dark:border-stone-800 pb-4 md:pb-0">
              <time class="text-stone-400 dark:text-stone-500 font-serif italic text-lg tracking-widest block">{collection.date.replace(/-/g, '.')}</time>
            </div>
            <div class="md:col-span-9 lg:col-span-8 lg:col-start-4">
              <a href={`/gallery/${collection.groupKey}`} class="block group/link cursor-pointer">
                <div class="relative mb-4 md:mb-6">
                  {collection.count > 1 && (
                    <>
                      <div class="absolute inset-0 bg-stone-300 dark:bg-stone-800/60 translate-x-2 translate-y-2 shadow-sm rounded-sm pointer-events-none"></div>
                      <div class="absolute inset-0 bg-stone-200 dark:bg-stone-900/40 translate-x-1 translate-y-1 shadow-sm rounded-sm pointer-events-none"></div>
                    </>
                  )}
                  <div class="relative z-10 w-full overflow-hidden shadow-sm bg-stone-200 dark:bg-stone-900">
                    <img src={collection.coverImage} alt={collection.title} loading="lazy" decoding="async" class="w-full h-auto object-cover filter grayscale-[10%] dark:opacity-85 group-hover/link:grayscale-0 group-hover/link:opacity-100 transition-all duration-[1s] ease-out group-hover/link:scale-[1.02]" />
                  </div>
                </div>
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 md:gap-4 border-b border-transparent group-hover/link:border-stone-900 dark:group-hover/link:border-stone-100 pb-2 transition-colors duration-500">
                  <div>
                    <span class="text-[10px] uppercase tracking-[0.3em] text-stone-500 dark:text-stone-400 mb-1.5 md:mb-2 block">
                      {collection.count > 1 ? `[Series] · ${collection.category}` : `[Single] · ${collection.category}`}
                    </span>
                    <h2 class="text-xl md:text-2xl font-serif text-stone-900 dark:text-stone-100 transition-colors group-hover/link:text-stone-500">{collection.title}</h2>
                  </div>
                  <span class="text-xs font-medium text-stone-900 dark:text-stone-100 tracking-widest uppercase opacity-40 group-hover/link:opacity-100 transition-opacity">翻阅 →</span>
                </div>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>

<script>
  function initBackLogic() {
    const backBtn = document.getElementById('back-btn');
    if (!backBtn) return;

    backBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (window.history.length > 1 && document.referrer.includes(window.location.host)) {
        window.history.back();
      } else {
        window.location.href = '/'; 
      }
    });
  }

  function initNavbar() {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLines = document.querySelectorAll('.nav-line');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    
    if (!toggleBtn || !mobileMenu) return;

    let isOpen = false;

    toggleBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      
      if (isOpen) {
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
        mobileMenu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        
        navLines[0].style.transform = 'translateY(0.5px) rotate(45deg)';
        navLines[1].style.transform = 'translateY(-0.5px) rotate(-45deg)';
        
        document.body.style.overflow = 'hidden';

        mobileLinks.forEach((link, index) => {
          setTimeout(() => {
            link.classList.remove('translate-y-4', 'opacity-0');
            link.classList.add('translate-y-0', 'opacity-100');
          }, 150 + index * 50);
        });
      } else {
        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        mobileMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
        
        navLines[0].style.transform = 'translateY(-2px) rotate(0deg)';
        navLines[1].style.transform = 'translateY(2px) rotate(0deg)';
        
        document.body.style.overflow = '';

        mobileLinks.forEach(link => {
          link.classList.remove('translate-y-0', 'opacity-100');
          link.classList.add('translate-y-4', 'opacity-0');
        });
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        toggleBtn.click();
      }
    });
  }

  function initFilters() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.collection-item');
    const slider = document.getElementById('active-slider');
    let currentActiveBtn = document.querySelector('.filter-btn[data-active="true"]');

    if (filterButtons.length === 0 || galleryItems.length === 0 || !slider) return;

    const moveSlider = (btn) => {
      slider.style.opacity = '1';
      slider.style.width = `${btn.offsetWidth}px`;
      slider.style.height = `${btn.offsetHeight}px`;
      slider.style.transform = `translate(${btn.offsetLeft}px, ${btn.offsetTop}px)`;
    };

    setTimeout(() => {
      if (currentActiveBtn) moveSlider(currentActiveBtn);
    }, 50);

    window.addEventListener('resize', () => {
      if (currentActiveBtn) moveSlider(currentActiveBtn);
    });

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const targetCategory = button.getAttribute('data-target');
        currentActiveBtn = button;
        
        moveSlider(button);

        filterButtons.forEach(btn => {
          btn.setAttribute('data-active', 'false');
          btn.classList.remove('text-stone-900', 'dark:text-stone-100');
          btn.classList.add('text-stone-500', 'dark:text-stone-400');
        });

        button.setAttribute('data-active', 'true');
        button.classList.remove('text-stone-500', 'dark:text-stone-400');
        button.classList.add('text-stone-900', 'dark:text-stone-100');

        galleryItems.forEach(item => {
          const itemCategory = item.getAttribute('data-category');
          item.style.display = (targetCategory === 'all' || itemCategory === targetCategory) ? 'block' : 'none';
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initBackLogic();
    initNavbar();
    initFilters();
  });
  document.addEventListener('astro:page-load', () => {
    initBackLogic();
    initNavbar();
    initFilters();
  });
</script>