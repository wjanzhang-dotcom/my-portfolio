---
// src/pages/gallery/index.astro
import Layout from '../../layouts/Layout.astro';

const GALLERY_API_KEY = import.meta.env.NOTION_GALLERY_API_KEY;
const GALLERY_DB_ID = import.meta.env.NOTION_GALLERY_DB_ID;

const response = await fetch(`https://api.notion.com/v1/databases/${GALLERY_DB_ID}/query`, {
  method: 'POST', headers: { 'Authorization': `Bearer ${GALLERY_API_KEY}`, 'Notion-Version': '2022-06-28', 'Content-Type': 'application/json' },
  body: JSON.stringify({ sorts: [{ property: 'Date', direction: 'descending' }] })
});
const data = await response.json();

const photoMap = {};
data.results?.forEach((page) => {
  const rawSlug = page.properties.Slug?.rich_text[0]?.plain_text || 'untitled';
  const groupKey = rawSlug.replace(/-?\d+$/, ''); 
  if (!photoMap[groupKey]) {
    const rawTitle = page.properties.Title?.title[0]?.plain_text || '未命名';
    photoMap[groupKey] = {
      groupKey, title: rawTitle.split('-')[0], category: page.properties.Category?.select?.name || '未分类',
      location: page.properties.Location?.rich_text[0]?.plain_text || '', date: page.properties.Date?.date?.start || '', coverImage: page.properties.ImageURL?.url || '', count: 0 
    };
  }
  photoMap[groupKey].count += 1;
});

let collections = Object.values(photoMap).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
let totalPhotos = collections.reduce((acc, c) => acc + c.count, 0);
const catStats = collections.reduce((acc, c) => { acc[c.category] = (acc[c.category] || 0) + c.count; return acc; }, {});
const categories = Object.keys(catStats).map(cat => ({ name: cat, photoCount: catStats[cat] }));
---

<Layout title="生活视觉切片 | Gallery">
  <main class="min-h-screen text-stone-900 dark:text-stone-100 py-24 px-6 md:px-12 max-w-7xl mx-auto font-sans transition-colors duration-500">
    <header class="mb-32 max-w-3xl">
      <h1 class="text-5xl md:text-6xl font-serif tracking-[0.15em] text-stone-900 dark:text-stone-100 mb-6 font-light uppercase">Visual Diary</h1>
      <p class="text-xs font-sans text-stone-500 dark:text-stone-400 tracking-[0.3em] uppercase mb-16">— 生活视觉切片 · Moments & Archive</p>
      <div class="flex flex-wrap gap-8 text-sm tracking-widest uppercase" id="filter-container">
        <button class="filter-btn text-stone-900 dark:text-stone-100 border-b border-stone-900 dark:border-stone-100 pb-1" data-target="all" data-active="true">全部 ({totalPhotos})</button>
        {categories.map((cat) => (
          <button class="filter-btn text-stone-400 dark:text-stone-500 hover:text-stone-700 dark:hover:text-stone-300 border-b border-transparent pb-1 transition-all" data-target={cat.name} data-active="false">{cat.name} ({cat.photoCount})</button>
        ))}
      </div>
    </header>

    <div class="space-y-32 md:space-y-48" id="gallery-container">
      {collections.map((collection) => (
        <article class="collection-item reveal-item" data-category={collection.category}>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
            
            <div class="md:col-span-3 lg:col-span-2 pt-2 md:text-right md:pr-4 border-b md:border-b-0 md:border-r border-stone-200 dark:border-stone-800 pb-4 md:pb-0">
              <time class="text-stone-400 dark:text-stone-500 font-serif italic text-lg tracking-widest block">{collection.date.replace(/-/g, '.')}</time>
            </div>

            <div class="md:col-span-9 lg:col-span-8 lg:col-start-4">
              <a href={`/gallery/${collection.groupKey}`} class="block group/link cursor-pointer">
                
                {/* 视觉分层：合集 vs 单张 */}
                <div class="relative mb-6">
                  {/* 合集：物理层级叠影 */}
                  {collection.count > 1 && (
                    <>
                      <div class="absolute inset-0 bg-stone-300 dark:bg-stone-800/60 translate-x-3 translate-y-3 shadow-sm rounded-sm pointer-events-none"></div>
                      <div class="absolute inset-0 bg-stone-200 dark:bg-stone-900/40 translate-x-1.5 translate-y-1.5 shadow-sm rounded-sm pointer-events-none"></div>
                    </>
                  )}
                  {/* 本体 */}
                  <div class="relative z-10 w-full overflow-hidden shadow-sm bg-stone-200 dark:bg-stone-900">
                    <img src={collection.coverImage} alt={collection.title} loading="lazy" decoding="async" class="w-full h-auto object-cover filter grayscale-[10%] dark:opacity-85 group-hover/link:grayscale-0 group-hover/link:opacity-100 transition-all duration-[1s] ease-out group-hover/link:scale-[1.02]" />
                  </div>
                </div>

                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-transparent group-hover/link:border-stone-900 dark:group-hover/link:border-stone-100 pb-2 transition-colors duration-500">
                  <div>
                    {/* 系列标识 */}
                    <span class="text-[10px] uppercase tracking-[0.3em] text-stone-500 dark:text-stone-400 mb-2 block">
                      {collection.count > 1 ? `[Series] · ${collection.category}` : `[Single] · ${collection.category}`}
                    </span>
                    <h2 class="text-2xl font-serif text-stone-900 dark:text-stone-100 transition-colors group-hover/link:text-stone-500">{collection.title}</h2>
                  </div>
                  <span class="text-xs font-medium text-stone-900 dark:text-stone-100 tracking-widest uppercase opacity-40 group-hover/link:opacity-100 transition-opacity">
                    翻阅 →
                  </span>
                </div>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>