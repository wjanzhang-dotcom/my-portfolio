---
import Hero from '../components/Hero.astro';
import Portfolio from '../components/Portfolio.astro';
import Projects from '../components/Projects.astro';
import Feed from '../components/Feed.astro';
// 核心引入：使用最新版 Astro 的引擎名称 ClientRouter
import { ClientRouter } from 'astro:transitions';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>张伟健 - 个人主页</title>
    <ClientRouter />
  </head>
  <body class="bg-white m-0 p-0 antialiased selection:bg-blue-500/30 overflow-x-clip">
    
    <main class="w-full flex flex-col gap-2 bg-white">
      <Hero />
      <Projects />
      <Portfolio />

      {/* 骨架层：仅保留大容器的上下边距和背景色，内部一切交给 Feed 组件接管 */}
      <section class="relative w-full pt-10 pb-24 md:pt-14 md:pb-32 px-6 md:px-[4vw] bg-[#f5f5f7] text-black">
        <div class="max-w-7xl mx-auto relative z-10">
          <Feed />
        </div>
      </section>

    </main>
  </body>
</html>