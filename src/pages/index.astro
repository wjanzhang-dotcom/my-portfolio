---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Portfolio from '../components/Portfolio.astro';
import Projects from '../components/Projects.astro';
import Feed from '../components/Feed.astro';
---

<Layout title="张伟健 - 个人主页">
  {/* 原本 body 的专属样式提权到这个外层容器上 */}
  <div class="bg-white m-0 p-0 antialiased selection:bg-blue-500/30 overflow-x-clip min-h-screen relative">
    
    <main class="w-full flex flex-col gap-2 bg-white">
      <Hero />
      <Projects />
      <Portfolio />

      {/* 骨架层：仅保留大容器的上下边距和背景色，内部一切交给 Feed 组件接管 */}
      <section class="relative w-full pt-10 pb-24 md:pt-14 md:pb-32 px-6 md:px-[4vw] bg-[#f5f5f7] text-black">
        <div class="max-w-7xl mx-auto relative z-10">
          <Feed />
        </div>
      </section>

    </main>
    
  </div>
</Layout>