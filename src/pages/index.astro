---
import Hero from '../components/Hero.astro';
import Portfolio from '../components/Portfolio.astro';
import Projects from '../components/Projects.astro';
import Feed from '../components/Feed.astro';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>张伟健 - 个人主页</title>
  </head>
  <body class="bg-white m-0 p-0 antialiased">
    <main>
      
      <Hero />
      <div class="h-4 bg-white w-full"></div> <Portfolio />
      <div class="h-4 bg-white w-full"></div>
      <Projects />

      <section class="max-w-3xl mx-auto px-4 sm:px-6 py-32">
        <h2 class="text-xl font-medium mb-12 text-gray-400 text-center">随笔碎片</h2>
        <Feed />
      </section>

    </main>
  </body>
</html>