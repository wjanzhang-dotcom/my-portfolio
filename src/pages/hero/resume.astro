---
// src/pages/resume.astro
import Layout from '../../layouts/Layout.astro';
import localResumeData from '../../data/resume.json';

// 1. 初始化鉴权配置
const API_KEY = import.meta.env.NOTION_API_KEY;
const DB_ID = import.meta.env.NOTION_RESUME_DB_ID;

const fetchHeaders = {
  'Authorization': `Bearer ${API_KEY}`,
  'Notion-Version': '2022-06-28',
  'Content-Type': 'application/json'
};

// 2. 核心数据清洗管道
let notionExperiences = [];

try {
  // 第 1 步：原生 Fetch 请求 Notion 数据库
  const dbResponse = await fetch(`https://api.notion.com/v1/databases/${DB_ID}/query`, {
    method: 'POST',
    headers: fetchHeaders,
    body: JSON.stringify({
      sorts: [{ property: '起止时间', direction: 'descending' }]
    })
  });

  if (!dbResponse.ok) {
    throw new Error(`数据库请求失败，状态码: ${dbResponse.status}`);
  }

  const dbData = await dbResponse.json();

  // 第 2 步：并发请求页面内部的 Blocks
  notionExperiences = await Promise.all(
    dbData.results.map(async (page) => {
      const props = page.properties;
      
      const role = props['头衔/角色']?.title?.[0]?.plain_text || '未命名职位';
      const company = props['组织机构']?.rich_text?.[0]?.plain_text || '';
      const summary = props['业务介绍']?.rich_text?.[0]?.plain_text || '';

      const dateObj = props['起止时间']?.date;
      const startDate = dateObj?.start ? dateObj.start.substring(0, 7).replace('-', '/') : '';
      const endDate = dateObj?.end ? dateObj.end.substring(0, 7).replace('-', '/') : '';

      // 原生 Fetch 请求页面区块内容
      const blocksResponse = await fetch(`https://api.notion.com/v1/blocks/${page.id}/children`, {
        method: 'GET',
        headers: fetchHeaders
      });
      
      const blocksData = await blocksResponse.json();
      
      const listBlocks = (blocksData.results || []).filter(
        (b) => b.type === 'numbered_list_item' || b.type === 'bulleted_list_item'
      );

      const achievements = listBlocks.map((block) => {
        const type = block.type;
        const textNodes = block[type].rich_text || [];
        
        return textNodes.map(node => {
          let text = node.plain_text;
          if (node.annotations?.bold) {
            text = `**${text}**`;
          }
          return text;
        }).join('');
      });

      return {
        company,
        role,
        startDate,
        endDate,
        title: role,
        summary,
        projectTags: [], 
        achievements,
      };
    })
  );
} catch (error) {
  console.error("底层 Fetch 请求被拦截或失败:", error);
}

// 3. 整合数据
const resumeData = {
  header: localResumeData.header,
  tags: localResumeData.tags,
  education: localResumeData.education || [], // 新增：挂载本地 JSON 中的教育数据
  experiences: notionExperiences,
};
---

<Layout title="张伟健 - 履历">
  
  <div class="bg-white text-zinc-900 font-sans antialiased selection:bg-zinc-200 min-h-screen relative w-full flex flex-col">

    <button onclick="window.print()" class="fixed top-20 right-6 md:top-24 md:right-10 inline-flex items-center gap-2 text-sm font-medium text-zinc-500 hover:text-zinc-900 transition-colors bg-white px-4 py-2 rounded-md border border-zinc-200 shadow-sm z-40 cursor-pointer print-hide">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
      打印 / 导出 PDF
    </button>

    <main class="max-w-4xl mx-auto px-6 pt-16 md:pt-24 pb-32 print-main w-full">
      
      {/* 模块：头部个人信息 */}
      <header class="mb-12 print-header">
        <h1 class="text-4xl font-bold tracking-tight mb-4 text-zinc-900">{resumeData.header.title}</h1>
        <p class="text-zinc-700 leading-relaxed text-sm md:text-base max-w-2xl" set:html={resumeData.header.description}></p>
      </header>

      {/* 模块：核心能力标签（缩减底部间距，为接下来的教育板块留白） */}
      <div class="flex flex-wrap gap-2 mb-10 print-tags pb-8 border-b border-zinc-200">
        {resumeData.tags.map((tag) => (
          <span class="px-3 py-1 rounded border border-zinc-300 text-zinc-700 text-sm font-medium">{tag}</span>
        ))}
      </div>

      {/* 新增模块：独立教育信息版块 */}
      {resumeData.education && resumeData.education.length > 0 && (
        <section class="print-section mb-12 border-b border-zinc-200 pb-10">
          <h2 class="text-xl font-bold text-zinc-900 mb-6 uppercase tracking-wider">教育经历</h2>
          <div class="space-y-4 print-timeline-container">
            {resumeData.education.map((edu) => (
              <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8 print-row page-break-avoid">
                <div class="md:w-56 shrink-0">
                  <div class="text-sm font-medium text-zinc-500 font-mono tracking-tight">
                    {edu.startDate} - {edu.endDate}
                  </div>
                </div>
                <div class="flex-1 flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
                  <h3 class="text-lg font-bold text-zinc-900">{edu.school}</h3>
                  <span class="text-sm text-zinc-600 font-medium">{edu.degree}</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* 模块：综合经历 */}
      <section class="print-section">
        <h2 class="text-xl font-bold text-zinc-900 mb-8 uppercase tracking-wider">职业与独立实践经历</h2>
        
        <div class="space-y-12 md:space-y-16 print-timeline-container">
          {resumeData.experiences.map((exp) => (
            <div class="flex flex-col md:flex-row gap-4 md:gap-8 print-row page-break-avoid">
              
              <div class="md:w-56 shrink-0">
                <div class="text-sm font-medium text-zinc-500 font-mono tracking-tight">
                  {exp.startDate} - {exp.endDate ? exp.endDate : '至今'}
                </div>
                <div class="text-base font-bold text-zinc-900 mt-1">{exp.company}</div>
              </div>

              <div class="flex-1">
                <h3 class="text-lg font-bold text-zinc-900 mb-3">{exp.title}</h3>
                
                {exp.summary && <p class="text-sm text-zinc-500 mb-4 leading-relaxed">{exp.summary}</p>}

                {exp.projectTags && exp.projectTags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {exp.projectTags.map((tag) => (
                      <span class="px-2 py-0.5 rounded border border-zinc-200 text-xs text-zinc-600">{tag}</span>
                    ))}
                  </div>
                )}

                <ul class="space-y-3 text-sm text-zinc-700 leading-relaxed list-none">
                  {exp.achievements.map((achievement) => {
                    const htmlAchievement = achievement.replace(/\*\*(.*?)\*\*/g, '<strong class="text-zinc-900 font-bold">$1</strong>');
                    return (
                      <li class="relative pl-4 before:absolute before:left-0 before:top-2 before:w-1 before:h-1 before:bg-zinc-400 before:rounded-full" set:html={htmlAchievement}></li>
                    );
                  })}
                </ul>
              </div>

            </div>
          ))}
        </div>
      </section>

    </main>
  </div>
</Layout>

<style is:global>
  @media print {
    html, body { 
      background-color: #ffffff !important; 
      color: #000000 !important; 
      font-size: 10pt !important; 
      line-height: 1.5 !important; 
    }
    .print-hide { display: none !important; }
    
    @page { 
      size: A4; 
      margin: 15mm 15mm 15mm 15mm; 
    }
    
    .print-main { padding: 0 !important; margin: 0 !important; max-width: 100% !important; width: 100% !important; }
    .print-header { margin-bottom: 8mm !important; }
    .print-header h1 { font-size: 24pt !important; margin-bottom: 2mm !important; color: #000 !important; }
    .print-header p { font-size: 10.5pt !important; color: #333 !important; }
    
    .print-tags { margin-bottom: 8mm !important; gap: 2mm !important; padding-bottom: 4mm !important; border-bottom: 1px solid #ccc !important; }
    .print-tags span { font-size: 9pt !important; padding: 1mm 2mm !important; border: 1px solid #999 !important; background: transparent !important; color: #000 !important;}
    
    .print-section { margin-bottom: 10mm !important; }
    .print-section h2 { font-size: 14pt !important; margin-bottom: 6mm !important; color: #000 !important;}
    
    .print-timeline-container { display: flex !important; flex-direction: column !important; gap: 8mm !important; }
    
    .page-break-avoid { 
      page-break-inside: avoid !important; 
      break-inside: avoid !important; 
    }
    
    .print-row { display: flex !important; flex-direction: row !important; gap: 6mm !important; align-items: flex-start !important; }
    .print-row > .shrink-0 { width: 45mm !important; flex-shrink: 0 !important; }
    .print-row > .shrink-0 .font-mono { font-size: 9.5pt !important; color: #555 !important; }
    .print-row > .shrink-0 .text-base { font-size: 11pt !important; color: #000 !important; margin-top: 0.5mm !important; }
    .print-row > .shrink-0 .text-sm { font-size: 9.5pt !important; color: #555 !important; }
    
    .print-row > .flex-1 h3 { font-size: 12pt !important; margin-bottom: 2mm !important; color: #000 !important; }
    .print-row > .flex-1 span { border-color: #999 !important; color: #333 !important; }
    .print-row > .flex-1 ul { margin: 0 !important; }
    .print-row > .flex-1 ul li { font-size: 10pt !important; line-height: 1.5 !important; color: #222 !important; margin-bottom: 1.5mm !important; padding-left: 3.5mm !important; }
    .print-row > .flex-1 ul li:last-child { margin-bottom: 0 !important; }
    .print-row > .flex-1 ul li::before { top: 2mm !important; width: 1mm !important; height: 1mm !important; background-color: #666 !important; }
    
    h1, h2, h3 { page-break-after: avoid !important; break-after: avoid !important; }
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  }
</style>