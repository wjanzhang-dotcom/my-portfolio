---
// src/pages/thanks.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="致谢 | Acknowledgement">
  
  <nav class="sticky top-0 z-50 w-full bg-white/70 dark:bg-stone-900/70 backdrop-blur-md border-b border-stone-200/50 dark:border-stone-800/50 transition-colors duration-500">
    <div class="max-w-7xl mx-auto px-6 md:px-12 h-12 flex items-center justify-between text-xs tracking-[0.2em] uppercase font-sans">
      <button id="back-btn" class="text-stone-950 dark:text-white hover:opacity-50 transition-opacity z-50 flex items-center" aria-label="返回上一页">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </button>

      <div class="hidden md:flex items-center gap-8 text-stone-500 dark:text-stone-400">
        <a href="/" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">首页</a>
        <a href="/resume" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">个人信息</a>
        <a href="/projects" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">实验项目</a>
        <a href="/gallery" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">视觉切片</a>
        <a href="/thanks" class="text-stone-900 dark:text-stone-100 font-medium">感谢</a>
      </div>

      <button id="menu-toggle" class="md:hidden flex flex-col justify-center items-center w-8 h-8 z-50 focus:outline-none" aria-label="Toggle Menu">
        <span class="nav-line w-4 h-[1px] bg-stone-900 dark:bg-stone-100 transition-transform duration-300 ease-out origin-center" style="transform: translateY(-2px) rotate(0deg);"></span>
        <span class="nav-line w-4 h-[1px] bg-stone-900 dark:bg-stone-100 transition-transform duration-300 ease-out origin-center" style="transform: translateY(2px) rotate(0deg);"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="fixed inset-0 bg-white/95 dark:bg-stone-950/95 backdrop-blur-xl z-40 md:hidden flex flex-col pt-24 px-8 gap-8 text-sm tracking-[0.25em] uppercase transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] opacity-0 pointer-events-none -translate-y-4">
    <a href="/" class="mobile-nav-link text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-all duration-300 transform translate-y-4 opacity-0">首页</a>
    <a href="/resume" class="mobile-nav-link text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-all duration-300 transform translate-y-4 opacity-0">个人信息</a>
    <a href="/projects" class="mobile-nav-link text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-all duration-300 transform translate-y-4 opacity-0">实验项目</a>
    <a href="/gallery" class="mobile-nav-link text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-all duration-300 transform translate-y-4 opacity-0">视觉切片</a>
    <a href="/thanks" class="mobile-nav-link text-stone-950 dark:text-white font-medium border-b border-stone-900 dark:border-stone-100 pb-1 self-start transform translate-y-4 opacity-0">感谢</a>
  </div>

  <main class="min-h-screen text-stone-900 dark:text-stone-100 pt-20 pb-40 px-6 md:px-12 max-w-5xl mx-auto font-sans transition-colors duration-500">
    
    <header class="mb-24 md:mb-32">
      <h1 class="text-4xl md:text-5xl tracking-[0.2em] text-stone-900 dark:text-stone-100 mb-6 font-light uppercase">Acknowledgement</h1>
      <p class="text-[10px] md:text-xs text-stone-500 dark:text-stone-400 tracking-[0.3em] uppercase">— 致敬那些构成这个数字空间的齿轮与火花</p>
    </header>

    <div class="flex flex-col">
      
      {/* SECTION 1: The Stack */}
      <section class="mb-20">
        <h2 class="text-xs tracking-[0.4em] uppercase text-stone-400 dark:text-stone-500 mb-8 font-medium">01 / The Stack</h2>
        <div class="border-t border-stone-900 dark:border-stone-100">
          
          <div class="grid grid-cols-1 md:grid-cols-12 gap-y-2 gap-x-8 py-8 border-b border-stone-200 dark:border-stone-800">
            <div class="md:col-span-4 flex flex-col justify-start">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 3.82-13.04l.18-.24a.68.68 0 0 1 1.12 0l.18.24A22 22 0 0 1 18 15z"></path><path d="m9 12 3 3"></path></svg>
                  <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">Astro</h3>
                </a>
                <span class="text-stone-300 dark:text-stone-700">&</span>
                <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"></path></svg>
                  <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">Tailwind</h3>
                </a>
              </div>
            </div>
            <div class="md:col-span-8 mt-2 md:mt-0">
              <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 font-light leading-relaxed max-w-2xl">提供极致的极简骨架与像素级的视觉皮囊。Zero-JS 赋予了页面呼吸的轻盈感。</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-y-2 gap-x-8 py-8 border-b border-stone-200 dark:border-stone-800">
            <div class="md:col-span-4 flex flex-col justify-start">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <a href="https://www.notion.so" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M3 15h6"></path><path d="M3 18h6"></path></svg>
                  <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">Notion</h3>
                </a>
                <span class="text-stone-300 dark:text-stone-700">&</span>
                <a href="https://www.cloudflare.com" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg>
                  <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">Cloudflare</h3>
                </a>
              </div>
            </div>
            <div class="md:col-span-8 mt-2 md:mt-0">
              <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 font-light leading-relaxed max-w-2xl">作为无头数据中心与边缘调度物流网络，安静地在幕后承载每一张视觉切片。</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-y-2 gap-x-8 py-8 border-b border-stone-200 dark:border-stone-800">
            <div class="md:col-span-4 flex flex-col justify-start">
              <a href="https://vercel.com" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 w-fit text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                {/* Vercel 极简三角图标 */}
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 22 20 2 20"></polygon></svg>
                <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">Vercel</h3>
              </a>
            </div>
            <div class="md:col-span-8 mt-2 md:mt-0">
              <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 font-light leading-relaxed max-w-2xl">提供优雅的公网橱窗，让本地的代码最终能够在云端映射为真实的像素。</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-y-2 gap-x-8 py-8 border-b border-stone-200 dark:border-stone-800">
            <div class="md:col-span-4 flex flex-col justify-start">
              <a href="https://code.visualstudio.com" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 w-fit text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">VS Code</h3>
              </a>
            </div>
            <div class="md:col-span-8 mt-2 md:mt-0">
              <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 font-light leading-relaxed max-w-2xl">作为构建这个数字空间的绝对主力工作台，在深色模式下见证了所有的逻辑推演与代码重构。</p>
            </div>
          </div>
          
        </div>
      </section>

      {/* SECTION 2: The Workflow */}
      <section class="mb-20">
        <h2 class="text-xs tracking-[0.4em] uppercase text-stone-400 dark:text-stone-500 mb-8 font-medium">02 / The Workflow</h2>
        <div class="border-t border-stone-900 dark:border-stone-100">
          
          <div class="grid grid-cols-1 md:grid-cols-12 gap-y-2 gap-x-8 py-8 border-b border-stone-200 dark:border-stone-800">
            <div class="md:col-span-4 flex flex-col justify-start">
              <a href="https://www.make.com" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 w-fit text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M13 6h3a2 2 0 0 1 2 2v7"></path><line x1="6" y1="9" x2="6" y2="21"></line></svg>
                <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">Make.com</h3>
              </a>
            </div>
            <div class="md:col-span-8 mt-2 md:mt-0">
              <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 font-light leading-relaxed max-w-2xl">提供核心工作流的自动化调度，无缝且精确地连接了数字空间的各个孤岛。</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-y-2 gap-x-8 py-8 border-b border-stone-200 dark:border-stone-800">
            <div class="md:col-span-4 flex flex-col justify-start">
              <a href="https://www.deepseek.com" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 w-fit text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
                <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">DeepSeek</h3>
              </a>
            </div>
            <div class="md:col-span-8 mt-2 md:mt-0">
              <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 font-light leading-relaxed max-w-2xl">提供了高效的文章摘要提炼与语义解析，大幅加速了内容生态的流转与构建。</p>
            </div>
          </div>

        </div>
      </section>

      {/* SECTION 3: The Sparks */}
      <section class="mb-24">
        <h2 class="text-xs tracking-[0.4em] uppercase text-stone-400 dark:text-stone-500 mb-8 font-medium">03 / The Sparks</h2>
        <div class="border-t border-stone-900 dark:border-stone-100">
          
          <div class="grid grid-cols-1 md:grid-cols-12 gap-y-2 gap-x-8 py-8 border-b border-stone-200 dark:border-stone-800">
            <div class="md:col-span-4 flex flex-col justify-start">
              <a href="https://gemini.google.com" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-1.5 w-fit text-stone-900 dark:text-stone-100 hover:text-stone-500 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path><path d="M5 3v4"></path><path d="M19 17v4"></path><path d="M3 5h4"></path><path d="M17 19h4"></path></svg>
                <h3 class="text-sm tracking-widest uppercase font-medium group-hover:underline underline-offset-4">Gemini</h3>
              </a>
            </div>
            <div class="md:col-span-8 mt-2 md:mt-0">
              <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 font-light leading-relaxed max-w-2xl">作为站点的首席思维伙伴。在每一个报错的深夜与重构的清晨，提供克制且精准的逻辑赋能。</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-y-2 gap-x-8 py-8 border-b border-stone-200 dark:border-stone-800">
            <div class="md:col-span-4 flex flex-col justify-start">
              <h3 class="text-sm tracking-widest uppercase font-medium">小哈</h3>
            </div>
            <div class="md:col-span-8 mt-2 md:mt-0">
              <p class="text-xs md:text-sm text-stone-500 dark:text-stone-400 font-light leading-relaxed max-w-2xl">感谢最为纯粹的陪伴。脚边的温度和奔跑的背影，是冰冷代码世界之外最柔软的现实锚点。</p>
            </div>
          </div>

        </div>
      </section>

      {/* 特别鸣谢：绝对极简的中央阵列 */}
      <section class="pt-24 border-t border-stone-200 dark:border-stone-800 flex flex-col items-center justify-center text-center">
        <p class="text-[10px] text-stone-400 tracking-[0.4em] uppercase mb-16 font-medium">Special Mentions</p>
        <div class="flex flex-col space-y-8">
          <span class="text-lg md:text-xl font-light tracking-[0.3em] md:tracking-[0.5em] uppercase text-stone-900 dark:text-stone-100">张雪好机车</span>
          <span class="text-lg md:text-xl font-light tracking-[0.3em] md:tracking-[0.5em] uppercase text-stone-900 dark:text-stone-100">银河护卫队的小伙伴</span>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  function initBackLogic() {
    const backBtn = document.getElementById('back-btn');
    if (!backBtn) return;
    backBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (window.history.length > 1 && document.referrer.includes(window.location.host)) {
        window.history.back();
      } else {
        window.location.href = '/'; 
      }
    });
  }

  function initNavbar() {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLines = document.querySelectorAll('.nav-line');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    
    if (!toggleBtn || !mobileMenu) return;

    let isOpen = false;

    toggleBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      if (isOpen) {
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
        mobileMenu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        navLines[0].style.transform = 'translateY(0.5px) rotate(45deg)';
        navLines[1].style.transform = 'translateY(-0.5px) rotate(-45deg)';
        document.body.style.overflow = 'hidden';

        mobileLinks.forEach((link, index) => {
          setTimeout(() => {
            link.classList.remove('translate-y-4', 'opacity-0');
            link.classList.add('translate-y-0', 'opacity-100');
          }, 150 + index * 50);
        });
      } else {
        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        mobileMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
        navLines[0].style.transform = 'translateY(-2px) rotate(0deg)';
        navLines[1].style.transform = 'translateY(2px) rotate(0deg)';
        document.body.style.overflow = '';

        mobileLinks.forEach(link => {
          link.classList.remove('translate-y-0', 'opacity-100');
          link.classList.add('translate-y-4', 'opacity-0');
        });
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        toggleBtn.click();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initBackLogic();
    initNavbar();
  });
  document.addEventListener('astro:page-load', () => {
    initBackLogic();
    initNavbar();
  });
</script>