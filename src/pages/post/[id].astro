---
export async function getStaticPaths() {
  const apiKey = import.meta.env.NOTION_API_KEY;
  const dbId = import.meta.env.NOTION_DATABASE_ID;
  const response = await fetch(`https://api.notion.com/v1/databases/${dbId}/query`, {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${apiKey}`, 'Notion-Version': '2022-06-28', 'Content-Type': 'application/json' },
    body: JSON.stringify({ filter: { property: 'Status', status: { equals: 'Published' } } })
  });
  const data = await response.json();
  return data.results.map((page) => ({ params: { id: page.id } }));
}

const { id } = Astro.params;
// 将 /post/123 重定向到 /post/123/1
return Astro.redirect(`/post/${id}/1`);
