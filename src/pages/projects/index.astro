---
// src/pages/projects/index.astro
import Layout from '../../layouts/Layout.astro';

const NOTION_API_KEY = import.meta.env.NOTION_API_KEY;
const DATABASE_ID = import.meta.env.NOTION_PROJECTS_DB_ID;

let projects = [];
let apiError = false;

// 1. 防御性数据获取管线
try {
  const response = await fetch(`https://api.notion.com/v1/databases/${DATABASE_ID}/query`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${NOTION_API_KEY}`,
      'Notion-Version': '2022-06-28',
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({})
  });

  const data = await response.json();

  if (!response.ok || !data.results) {
    console.error("❌ Notion API 请求被拒绝，错误详情:", data);
    apiError = true;
  } else {
    // 2. 数据清洗层
    projects = data.results.map((page: any) => {
      const props = page.properties;
      
      let rawLink = props['外链']?.url || '#';
      if (rawLink !== '#' && !rawLink.startsWith('http')) {
        rawLink = `https://${rawLink}`;
      }

      return {
        id: page.id,
        title: props['项目名称']?.title?.[0]?.plain_text || '未命名项目',
        tags: props['项目分类']?.multi_select?.map((t: any) => t.name) || [],
        status: props['状态']?.status?.name || 'Unknown',
        dateStart: props['起止时间']?.date?.start || '',
        dateEnd: props['起止时间']?.date?.end || '',
        link: rawLink
      };
    });
  }
} catch (e) {
  console.error("❌ 网络请求崩溃:", e);
  apiError = true;
}

// 3. 优雅降级
if (apiError || projects.length === 0) {
  console.warn("⚠️ 正在使用 Mock 数据进行渲染。请检查终端报错以修复 Notion 鉴权。");
  projects = [
    {
      id: 'mock-01',
      title: '创建个人网站',
      tags: ['vibe coding', 'AI赋能', '内容管线自动化', '编程', '全栈'],
      status: 'In progress',
      dateStart: '2026-05-28',
      dateEnd: '2026-06-05',
      link: 'https://newzwj.com'
    }
  ];
}
---

<Layout title="实验项目 | 张伟健">
  
  {/* 将原本的 body 样式迁移到这个顶级 div，同时确保 w-full 和 flex 布局适配 Layout */}
  <div class="bg-[#0a0a0c] text-white font-sans antialiased selection:bg-blue-500/30 min-h-screen relative w-full flex flex-col">
    
    {/* 背景光晕：从 fixed 改为 absolute，使其严格挂载在当前容器内，不干扰全局导航 */}
    <div class="absolute inset-0 bg-gradient-to-tr from-blue-900/5 via-black to-indigo-900/5 z-0 pointer-events-none"></div>

    <main class="relative z-10 max-w-6xl mx-auto px-6 py-24 md:py-32 w-full flex-1">
      <header class="mb-16 md:mb-24 pt-4">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-transparent bg-clip-text bg-gradient-to-r from-white to-zinc-500">
          实验项目
        </h1>
        <p class="text-zinc-400">基于 Notion 数据库动态生成的数字资产。</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {projects.map((project: any) => (
          <a 
            href={project.link} 
            target={project.link !== '#' ? '_blank' : '_self'} 
            rel="noopener noreferrer" 
            class="group block h-full p-8 bg-zinc-900/40 backdrop-blur-2xl border border-white/5 rounded-3xl hover:border-white/20 transition-all duration-500 hover:-translate-y-1 hover:bg-zinc-800/50 shadow-[0_4px_24px_rgba(0,0,0,0.1)] hover:shadow-[0_8px_30px_rgba(255,255,255,0.05)]"
          >
            <div class="flex flex-col h-full">
              <div class="flex justify-between items-center mb-8">
                {project.status === 'In progress' ? (
                  <span class="flex items-center text-[10px] uppercase tracking-wider font-mono text-blue-400 bg-blue-400/10 px-2.5 py-1 rounded-md border border-blue-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400 mr-2 animate-pulse"></span>
                    进行中
                  </span>
                ) : (
                  <span class="text-[10px] uppercase tracking-wider font-mono text-zinc-500 px-2.5 py-1 rounded-md bg-zinc-800/50 border border-zinc-700/50">
                    {project.status}
                  </span>
                )}
                
                <span class="text-xs text-zinc-500 font-mono tracking-tight">
                  {project.dateStart} {project.dateEnd ? `→ ${project.dateEnd}` : ''}
                </span>
              </div>

              <h3 class="text-2xl font-bold text-white mb-8 tracking-tight leading-snug group-hover:text-blue-400 transition-colors duration-300">
                {project.title}
              </h3>

              <div class="mt-auto flex flex-wrap gap-2 pt-6 border-t border-white/5">
                {project.tags.map((tag: string) => (
                  <span class="text-xs px-3 py-1.5 rounded-lg bg-black/40 text-zinc-300 border border-white/5 backdrop-blur-md">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </main>
  </div>
</Layout>