---
// Hero.astro
---
<section class="relative w-full bg-zinc-950 flex flex-col justify-center items-center overflow-hidden min-h-[42.85vw] py-24 md:py-[4vw] group">
  
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(59,130,246,0.12)_0,transparent_65%)] pointer-events-none"></div>

  <div class="relative z-10 w-full max-w-5xl px-6 flex flex-col items-center text-center">
    
    <span class="text-zinc-400 text-xs md:text-sm tracking-[0.2em] font-medium uppercase mb-6 md:mb-8">
      Resume & Portfolio
    </span>

    <h1 class="whitespace-nowrap text-[clamp(2.5rem,8vw,4.5rem)] font-bold text-white tracking-tight mb-14 md:mb-20 leading-none drop-shadow-md">
      你好，我是张伟健
    </h1>

    <div class="duang-text space-y-5 md:space-y-6 text-zinc-400 text-sm md:text-base mb-14 md:mb-20 max-w-3xl mx-auto leading-loose font-normal">
      <p>一名深耕 3C 硬件与科技内容的从业者，干过公关传播，干过媒体主笔，也干过运营工作</p>
      <p>现在习惯用 AI 重塑工作流，赋能自己</p>
      <p>在这里，你可以看到我的工作履历、我跑过的 10 公里，以及一起一起这里那里的足迹</p>
    </div>

    <div class="mobile-anim-container flex flex-col md:flex-row items-center justify-center gap-6 md:gap-8 w-full z-20" style="filter: url(#gooey);">
      
      <div class="mobile-anim-trigger transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] transform-gpu group-hover:-translate-y-2">
        <div class="magnetic-btn rounded-full">
          <a href="sports" class="btn-inner-dark block px-6 py-3 md:px-8 md:py-3.5 bg-zinc-800 text-white rounded-full text-sm md:text-base font-medium hover:bg-zinc-700 transition-all duration-300 group-hover:shadow-[0_10px_30px_rgba(255,255,255,0.15)]">
            <span class="magnetic-text inline-block pointer-events-none">运动记录</span>
          </a>
        </div>
      </div>

      <div class="mobile-anim-trigger transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] transform-gpu group-hover:-translate-y-2 z-10">
        <div class="magnetic-btn rounded-full">
          <a href="resume" class="btn-inner-light block relative px-8 py-3.5 md:px-10 md:py-4 bg-white text-zinc-950 rounded-full text-sm md:text-base font-bold hover:bg-zinc-200 transition-all duration-300 shadow-[0_0_15px_rgba(255,255,255,0.15)] group-hover:shadow-[0_10px_30px_rgba(255,255,255,0.4)]">
            <span class="magnetic-text inline-block pointer-events-none">工作履历</span>
          </a>
        </div>
      </div>

      <div class="mobile-anim-trigger transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] transform-gpu group-hover:-translate-y-2">
        <div class="magnetic-btn rounded-full">
          <a href="footprints" class="btn-inner-dark block px-6 py-3 md:px-8 md:py-3.5 bg-zinc-800 text-white rounded-full text-sm md:text-base font-medium hover:bg-zinc-700 transition-all duration-300 group-hover:shadow-[0_10px_30px_rgba(255,255,255,0.15)]">
            <span class="magnetic-text inline-block pointer-events-none">个人足迹</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .duang-text:hover p {
    color: #71717a; 
    transition: color 0.4s ease;
  }

  .duang-text p {
    display: inline-block;
    width: 100%;
    transition: color 0.3s ease, transform 0.3s ease;
    cursor: default;
    
    will-change: opacity, transform;
    
    opacity: 0;
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .duang-text p:hover {
    color: #ffffff; 
    transform: translateX(4px); 
  }

  .duang-text p:nth-child(1) { animation-delay: 0.1s; }
  .duang-text p:nth-child(2) { animation-delay: 0.25s; }
  .duang-text p:nth-child(3) { animation-delay: 0.4s; }

  @keyframes fade-in-up {
    0% { 
      opacity: 0; 
      transform: translateY(10px); 
    }
    100% { 
      opacity: 1; 
      transform: translateY(0) translateX(0); 
    }
  }

  /* ====================================================
     新增：移动端专属的伪悬浮状态（映射 Tailwind 的 Hover 样式）
     ==================================================== */
  .sim-hover {
    transform: translateY(-8px) !important;
  }
  .sim-hover .btn-inner-dark {
    background-color: #3f3f46 !important; /* 对应 hover:bg-zinc-700 */
    box-shadow: 0 10px 30px rgba(255,255,255,0.15) !important;
  }
  .sim-hover .btn-inner-light {
    background-color: #e4e4e7 !important; /* 对应 hover:bg-zinc-200 */
    box-shadow: 0 10px 30px rgba(255,255,255,0.4) !important;
  }
</style>

<script>
  // 1. 原本的 PC 端磁性吸附动画
  const initMagneticButtons = () => {
    if (!window.matchMedia("(pointer: fine)").matches) return;

    const magneticButtons = document.querySelectorAll('.magnetic-btn');

    magneticButtons.forEach((btn) => {
      const textContent = btn.querySelector('.magnetic-text');
      let requestAnimationFrameId = null; 

      btn.addEventListener('mousemove', (e) => {
        if (requestAnimationFrameId) {
          cancelAnimationFrame(requestAnimationFrameId);
        }

        requestAnimationFrameId = requestAnimationFrame(() => {
          const rect = btn.getBoundingClientRect();
          const h = rect.width / 2;
          const v = rect.height / 2;
          const x = e.clientX - rect.left - h;
          const y = e.clientY - rect.top - v;

          btn.style.transition = 'none'; 
          btn.style.transform = `translate(${x * 0.35}px, ${y * 0.35}px) scale(1.04)`;

          if (textContent) {
            textContent.style.transition = 'none';
            textContent.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px)`;
          }
        });
      });

      btn.addEventListener('mouseleave', () => {
        if (requestAnimationFrameId) {
          cancelAnimationFrame(requestAnimationFrameId);
        }
        
        btn.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        btn.style.transform = 'translate(0px, 0px) scale(1)';

        if (textContent) {
          textContent.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
          textContent.style.transform = 'translate(0px, 0px)';
        }
      });
    });
  };

  // 2. 新增：移动端专属滑动侦测波浪动画
  const initMobileAutoAnim = () => {
    // 强制隔离：仅在非精准设备（手机/触屏）上运行
    if (window.matchMedia("(pointer: fine)").matches) return;

    const container = document.querySelector('.mobile-anim-container');
    const triggers = document.querySelectorAll('.mobile-anim-trigger');
    if (!container || triggers.length === 0) return;

    // IntersectionObserver 引擎：监控容器是否进入视野
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        // 当按钮组进入屏幕达 80% 的时候触发
        if (entry.isIntersecting) {
          
          triggers.forEach((trigger, index) => {
            // 延时执行，制造 200ms 间隔的“波浪”视觉差
            setTimeout(() => {
              trigger.classList.add('sim-hover'); // 升起并亮起
              
              // 保持 800ms 后自动回落，完成一次“呼吸交互”
              setTimeout(() => {
                trigger.classList.remove('sim-hover');
              }, 800);
              
            }, index * 200); 
          });

        }
      });
    }, { threshold: 0.8 });

    observer.observe(container);
  };

  // 初始化绑定
  document.addEventListener('DOMContentLoaded', () => {
    initMagneticButtons();
    initMobileAutoAnim();
  });
  document.addEventListener('astro:page-load', () => {
    initMagneticButtons();
    initMobileAutoAnim();
  });
</script>