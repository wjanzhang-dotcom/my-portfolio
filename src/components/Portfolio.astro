---
// Gallery.astro
import { Image } from 'astro:assets';
// 引入移动到 assets 目录下的图片资源
import heroBg from '../assets/images/hero-bg.jpg';
import heroMountainFront from '../assets/images/hero-mountain-front.png';
---
<section class="relative w-full bg-zinc-950 overflow-hidden group">

  <a href="/gallery" class="block relative w-full h-auto cursor-pointer" aria-label="查看摄影集画廊">

    <div class="relative w-full bg-black flex justify-center items-center overflow-hidden">
      
      {/* 背景底层图片：开启首屏高优先级加载，物理宽度定制为 2560px 确保高分屏画质 */}
      <Image
        src={heroBg}
        alt="摄影底图"
        width={2560}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-auto min-h-[350px] md:min-h-0 object-cover object-center block opacity-90 md:transition-transform md:duration-1000 md:transform-gpu md:group-hover:scale-105"
      />

      <div class="absolute top-[15%] md:top-[16%] left-1/2 -translate-x-1/2 z-10 w-full px-4 flex flex-col items-center text-center pointer-events-none md:transition-transform md:duration-1000 md:group-hover:-translate-y-3">
        
        <p class="text-[clamp(0.8rem,1vw,1.1rem)] text-white/90 font-light tracking-[0.2em] md:tracking-[0.3em] mb-2 md:mb-4 drop-shadow-lg">
          在这里，你可以看到山野湖海与生活方式的视觉切片
        </p>

        <h2 class="text-[clamp(2.5rem,8vw,4.5rem)] font-bold text-white/80 tracking-tight leading-none drop-shadow-2xl">
          摄影集
        </h2>
        
      </div>

      {/* 前景遮挡图片：保持与背景图一致的加载优先级与 2560px 渲染宽度，消灭视觉闪烁 */}
      <Image
        src={heroMountainFront}
        alt="前景遮挡"
        width={2560}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute top-0 left-0 w-full h-auto min-h-[350px] md:min-h-0 object-cover object-center block z-20 pointer-events-none md:transition-all md:duration-1000 md:transform-gpu md:group-hover:scale-110 md:group-hover:-translate-y-1"
      />

    </div>

  </a>
</section>