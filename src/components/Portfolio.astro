<section class="w-full h-[70vh] relative overflow-hidden text-white flex flex-col justify-end items-start pb-16 pl-6 md:pb-24 md:pl-24">
  
  <div class="absolute inset-0 z-0">
    <img src="/hero-bg.jpg" alt="摄影作品背景" class="w-full h-full object-cover object-center scale-105" />
  </div>

  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent z-10"></div>

  <div class="relative z-20 flex flex-col items-start max-w-2xl">
    <h2 class="text-5xl md:text-7xl font-semibold tracking-tighter mb-4 drop-shadow-2xl">
      摄影集
    </h2>
    <p class="text-xl md:text-2xl text-white/90 mb-8 font-medium drop-shadow-lg text-left leading-relaxed">
      探索影像与生活方式的视觉切片。
    </p>
    <button class="px-8 py-3.5 bg-white text-black rounded-full text-base font-semibold hover:bg-gray-200 transition-colors shadow-2xl">
