---
// Projects.astro
---
<section class="relative w-full pt-24 md:pt-32 bg-[#0a0a0c] overflow-hidden group">
  
  <div class="absolute inset-0 bg-gradient-to-tr from-blue-900/10 via-black to-indigo-900/10 z-0"></div>

  <div class="relative z-10 w-full flex flex-col items-center px-6 md:px-16">
    
    <div class="text-center w-full max-w-4xl z-20 mb-12 md:mb-20">
      
      <h2 class="text-[clamp(2.5rem,8vw,4.5rem)] font-bold text-white tracking-tight leading-none mb-4 md:mb-6">
        实验项目
      </h2>
      
      <p class="text-zinc-400 text-sm md:text-base font-normal leading-loose mb-8 md:mb-12">
        在这里，你可以看到一些我个人主导的实验项目
      </p>

      <div class="flex flex-row justify-center gap-4 md:gap-6 z-20 relative">
        
        <div class="relative z-10">
          <div class="md:transition-transform md:duration-700 md:ease-[cubic-bezier(0.16,1,0.3,1)] md:transform-gpu md:group-hover:-translate-y-2">
            <div class="magnetic-btn rounded-full cursor-pointer">
              <button class="block px-6 py-3 md:px-8 md:py-3.5 bg-zinc-800/90 text-white rounded-full text-sm md:text-base font-medium border border-zinc-700/50 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] md:hover:bg-zinc-700 md:hover:border-zinc-600 transition-colors duration-300 md:group-hover:shadow-[0_10px_30px_rgba(255,255,255,0.1)] backdrop-blur-sm">
                <span class="magnetic-text inline-block pointer-events-none">运行沙盒</span>
              </button>
            </div>
          </div>
        </div>
        
        <div class="relative z-10">
          <div class="md:transition-transform md:duration-700 md:ease-[cubic-bezier(0.16,1,0.3,1)] md:transform-gpu md:group-hover:-translate-y-2">
            <div class="magnetic-btn rounded-full cursor-pointer">
              <a href="#" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center px-6 py-3 md:px-8 md:py-3.5 bg-zinc-800/90 text-white rounded-full text-sm md:text-base font-medium border border-zinc-700/50 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] md:hover:bg-zinc-700 md:hover:border-zinc-600 transition-colors duration-300 md:group-hover:shadow-[0_10px_30px_rgba(255,255,255,0.1)] backdrop-blur-sm">
                <span class="magnetic-text inline-block pointer-events-none">小红书主页 ↗</span>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="w-[90%] max-w-3xl min-h-[240px] md:min-h-[360px] p-6 md:p-12 bg-black/40 backdrop-blur-2xl border border-white/10 rounded-t-2xl md:rounded-t-3xl flex justify-center items-center relative">
      
      <div class="absolute top-4 left-4 md:top-6 md:left-6 flex gap-2">
        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
      </div>
      
      <span class="text-blue-400/60 text-sm md:text-base tracking-widest font-mono text-center break-words w-full px-4">
        > root@deepseeri:~# ./run_demo.sh <span class="animate-pulse">_</span>
      </span>

    </div>
  </div>
</section>

<style>
  /* 仅保留桌面端磁性按钮的归位回弹过渡，其余冗余 keyframes 已全部清空 */
  @media (min-width: 768px) {
    .magnetic-btn {
      transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .magnetic-text {
      transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
  }
</style>

<script>
  const initMagneticButtons = () => {
    if (!window.matchMedia("(pointer: fine)").matches) return;

    const magneticButtons = document.querySelectorAll('.magnetic-btn');

    magneticButtons.forEach((btn) => {
      const textContent = btn.querySelector('.magnetic-text');
      let requestAnimationFrameId = null; 

      btn.addEventListener('mousemove', (e) => {
        if (requestAnimationFrameId) cancelAnimationFrame(requestAnimationFrameId);

        requestAnimationFrameId = requestAnimationFrame(() => {
          const rect = btn.getBoundingClientRect();
          const h = rect.width / 2;
          const v = rect.height / 2;
          const x = e.clientX - rect.left - h;
          const y = e.clientY - rect.top - v;

          btn.style.transition = 'none'; 
          btn.style.transform = `translate(${x * 0.35}px, ${y * 0.35}px) scale(1.04)`;

          if (textContent) {
            textContent.style.transition = 'none';
            textContent.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px)`;
          }
        });
      });

      btn.addEventListener('mouseleave', () => {
        if (requestAnimationFrameId) cancelAnimationFrame(requestAnimationFrameId);
        
        btn.style.transition = ''; 
        btn.style.transform = 'translate(0px, 0px) scale(1)';

        if (textContent) {
          textContent.style.transition = '';
          textContent.style.transform = 'translate(0px, 0px)';
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initMagneticButtons);
  document.addEventListener('astro:page-load', initMagneticButtons);
</script>