<section class="relative w-full flex flex-col justify-start items-center pt-[15vw] pb-[10vw] md:pt-[6vw] md:pb-[4vw] px-[4vw] bg-gradient-to-br from-blue-500 via-blue-600 to-indigo-600 text-white text-center overflow-hidden">
  
  <div class="relative z-20 w-full flex flex-col items-center">
    
    <h2 class="text-[10vw] md:text-[4vw] font-bold tracking-tight drop-shadow-lg leading-none">
