---
// 1. 初始化环境变量与通信凭证
const apiKey = import.meta.env.NOTION_API_KEY;
const dbId = import.meta.env.NOTION_DATABASE_ID;

let feeds = [];
let isError = false;

try {
  // 2. 建立与 Notion 的底层通信管道
  const response = await fetch(`https://api.notion.com/v1/databases/${dbId}/query`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${apiKey}`,
      'Notion-Version': '2022-06-28',
      'Content-Type': 'application/json',
    },
  });

  if (!response.ok) {
    throw new Error('Notion API 连通失败，请检查 .env 密钥');
  }

  const data = await response.json();

  // 3. 执行数据清洗与精准映射
  if (data && data.results) {
    feeds = data.results.map((item) => {
      
      // 提取标题 (适配列名为 "Name" 或 "标题")
      const titleProp = item.properties['Name'] || item.properties['标题'];
      const title = titleProp?.title?.[0]?.plain_text || '无标题';

      // 提取摘要 (适配列名为 "Summary" 或 "摘要")
      const summaryProp = item.properties['Summary'] || item.properties['摘要'];
      const summary = summaryProp?.rich_text?.[0]?.plain_text || '摘要生成中...';

      // 提取日期 (适配列名为 "Date" 或 "日期"，无日期则降级读取创建时间)
      const dateProp = item.properties['Date'] || item.properties['日期'];
      const rawDate = dateProp?.date?.start || item.created_time;
      const formattedDate = new Date(rawDate).toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }).replace(/\//g, '-');

      return {
        id: item.id,
        title: title,
        summary: summary,
        date: formattedDate
      };
    });
  }
} catch (error) {
  console.error("Notion 数据抓取或解析遭遇致命错误:", error);
  isError = true;
}
---

<div class="w-full flex justify-center">
  {feeds.length > 0 ? (
    <div class="w-full max-w-4xl flex flex-col gap-6 md:gap-8">
      {feeds.map((item) => (
        /* 外层容器：接管整体物理交互 (点击下压) */
        <a href="#" class="group relative w-full cursor-pointer block transform active:scale-[0.98] transition-transform duration-300">
          
          <div class="relative flex flex-col p-6 md:p-8 bg-white border border-gray-100 rounded-3xl h-full transition-all duration-300 overflow-hidden">
            
                        <div class="relative z-10 flex flex-col flex-1">
              
              <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2 leading-tight">
                {item.title || "无标题 (请在底层 API 逻辑中增加 title 字段拉取)"}
              </h3>
              
              <div class="flex items-center gap-2 mb-4">
                <time class="text-xs font-semibold text-gray-400 tracking-wider uppercase">{item.date}</time>
              </div>
              
              <p class="text-sm md:text-base text-gray-500 leading-relaxed font-medium line-clamp-2">
                {item.summary || item.content}
              </p>

            </div>

          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="w-full max-w-4xl p-8 md:p-12 rounded-3xl bg-white border border-gray-100 text-center flex flex-col items-center justify-center gap-3 shadow-sm">
      <span class="text-2xl animate-bounce">📡</span>
      <span class="text-sm font-mono tracking-widest text-gray-400">正在建立底层通信管道...</span>
    </div>
  )}
</div>