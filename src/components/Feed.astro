---
// src/components/Feed.astro
const apiKey = import.meta.env.NOTION_API_KEY;
const dbId = import.meta.env.NOTION_DATABASE_ID;

let feeds = [];
let categoryInfo = {}; 
let totalPosts = 0;
let isError = false;

try {
  const response = await fetch(`https://api.notion.com/v1/databases/${dbId}/query`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${apiKey}`,
      'Notion-Version': '2022-06-28',
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      filter: { property: 'Status', status: { equals: 'Published' } },
      sorts: [{ property: 'Pinned', direction: 'descending' }, { property: 'Date', direction: 'descending' }]
    })
  });

  const data = await response.json();
  if (data && data.results) {
    feeds = data.results.map((item) => {
      const titleProp = item.properties['Name'] || item.properties['标题'];
      const summaryProp = item.properties['Summary'] || item.properties['摘要'];
      const dateProp = item.properties['Date'] || item.properties['日期'];
      const categoryProp = item.properties['Category'] || item.properties['分类'];
      
      const categoryName = categoryProp?.select?.name || '未分类';
      const categoryColor = categoryProp?.select?.color || 'default';

      if (!categoryInfo[categoryName]) {
        categoryInfo[categoryName] = { count: 0, color: categoryColor };
      }
      categoryInfo[categoryName].count++;
      totalPosts++;

      return {
        id: item.id,
        title: titleProp?.title?.[0]?.plain_text || '无标题',
        summary: summaryProp?.rich_text?.[0]?.plain_text || '摘要生成中...',
        date: new Date(dateProp?.date?.start || item.created_time).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-'),
        isPinned: item.properties['Pinned']?.checkbox || false,
        category: categoryName,
        categoryColor: categoryColor
      };
    });
  }
} catch (error) { isError = true; }

const flatColors = {
  blue: { capsule: 'bg-blue-50/80 text-blue-600 border-blue-200', inactive: 'bg-blue-50/80 text-blue-600 border-blue-200 hover:bg-blue-100', active: 'bg-blue-500 text-white border-blue-500' },
  emerald: { capsule: 'bg-emerald-50/80 text-emerald-600 border-emerald-200', inactive: 'bg-emerald-50/80 text-emerald-600 border-emerald-200 hover:bg-emerald-100', active: 'bg-emerald-500 text-white border-emerald-500' },
  green: { capsule: 'bg-green-50/80 text-green-600 border-green-200', inactive: 'bg-green-50/80 text-green-600 border-green-200 hover:bg-green-100', active: 'bg-green-500 text-white border-green-500' },
  yellow: { capsule: 'bg-yellow-50/80 text-yellow-700 border-yellow-200', inactive: 'bg-yellow-50/80 text-yellow-700 border-yellow-200 hover:bg-yellow-100', active: 'bg-yellow-500 text-white border-yellow-500' },
  orange: { capsule: 'bg-orange-50/80 text-orange-600 border-orange-200', inactive: 'bg-orange-50/80 text-orange-600 border-orange-200 hover:bg-orange-100', active: 'bg-orange-500 text-white border-orange-500' },
  red: { capsule: 'bg-red-50/80 text-red-600 border-red-200', inactive: 'bg-red-50/80 text-red-600 border-red-200 hover:bg-red-100', active: 'bg-red-500 text-white border-red-500' },
  pink: { capsule: 'bg-pink-50/80 text-pink-600 border-pink-200', inactive: 'bg-pink-50/80 text-pink-600 border-pink-200 hover:bg-pink-100', active: 'bg-pink-500 text-white border-pink-500' },
  purple: { capsule: 'bg-purple-50/80 text-purple-600 border-purple-200', inactive: 'bg-purple-50/80 text-purple-600 border-purple-200 hover:bg-purple-100', active: 'bg-purple-500 text-white border-purple-500' },
  brown: { capsule: 'bg-stone-50/80 text-stone-600 border-stone-200', inactive: 'bg-stone-50/80 text-stone-600 border-stone-200 hover:bg-stone-100', active: 'bg-stone-600 text-white border-stone-600' },
  gray: { capsule: 'bg-gray-50/80 text-gray-600 border-gray-200', inactive: 'bg-gray-50/80 text-gray-600 border-gray-200 hover:bg-gray-100', active: 'bg-gray-600 text-white border-gray-600' },
  default: { capsule: 'bg-white/80 text-gray-600 border-gray-200', inactive: 'bg-white/80 text-gray-600 border-gray-200 hover:bg-gray-50', active: 'bg-gray-900 text-white border-gray-900' }
};

const sortedCategories = Object.entries(categoryInfo).sort((a, b) => b[1].count - a[1].count);
const btnBaseClass = "category-filter-btn flex items-center gap-1.5 px-4 py-1.5 rounded-full text-[13px] font-medium transition-colors duration-200 border cursor-pointer shrink-0";
const unifiedCardStyle = "p-6 md:p-8 bg-white/40 backdrop-blur-xl border border-white/60 shadow-[0_8px_30px_rgba(0,0,0,0.04)] rounded-[24px] hover:shadow-[0_16px_40px_rgba(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-300";
---

<div class="w-full relative flex flex-col items-center">
  
  <div id="banner-sentinel" class="absolute top-0 w-full h-px invisible pointer-events-none"></div>

  <div id="banner-container" class="w-full sticky top-0 z-50 h-[72px] flex items-center justify-center">
    
    <div id="banner-bg" class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-screen bg-transparent border-b border-transparent transition-all duration-300 ease-out z-0"></div>
    
    {/* 🔥 核心修正：字号由 text-3xl 提权到 text-4xl/text-5xl，强制采用超清大图渲染。加入 backface-visibility 解决渲染抖动 */}
    <h2 id="section-title" class="relative z-10 text-4xl md:text-5xl font-bold tracking-tight text-gray-900 drop-shadow-sm origin-center" style="backface-visibility: hidden;">
      随笔碎片
    </h2>
  </div>

  <div class="w-full max-w-5xl mx-auto relative flex flex-col items-center pt-4 md:pt-6">
    
    <div id="scroll-sentinel" class="absolute top-0 w-full h-px invisible pointer-events-none"></div>

    <aside id="tags-nav" class="
      w-full lg:w-auto px-4 lg:px-0 z-40 mb-6 lg:mb-8
      sticky top-[72px] pt-2
      flex justify-start lg:justify-center overflow-x-auto hide-scrollbar
      transition-all duration-300 ease-out
    ">
      <div id="tags-flex" class="flex flex-row items-center justify-start lg:justify-center gap-2 lg:gap-3 w-max lg:w-auto mx-auto transition-all duration-300 py-1">
        <button data-base-class={btnBaseClass} data-active-class={flatColors.default.active} data-inactive-class={flatColors.default.inactive} class={`${btnBaseClass} ${flatColors.default.active}`} data-filter="all">
          <span>全部</span><span class="opacity-70 text-[10px] font-mono">{totalPosts}</span>
        </button>
        {sortedCategories.map(([catName, info]) => {
          const theme = flatColors[info.color] || flatColors.default;
          return (
            <button data-base-class={btnBaseClass} data-active-class={theme.active} data-inactive-class={theme.inactive} class={`${btnBaseClass} ${theme.inactive}`} data-filter={catName}>
              <span>{catName}</span><span class="opacity-70 text-[10px] font-mono">{info.count}</span>
            </button>
          )
        })}
      </div>
    </aside>

    <main class="w-full max-w-2xl px-4 md:px-0 flex flex-col gap-5 relative z-10">
      {feeds.map((item) => {
        const tagTheme = flatColors[item.categoryColor] || flatColors.default;
        return (
          <a href={`/post/${item.id}`} data-article-category={item.category} class="article-card group w-full cursor-pointer block transition-opacity duration-300">
            <div class={unifiedCardStyle}>
              <h3 transition:name={`title-${item.id}`} class="text-xl md:text-2xl font-bold text-gray-900 mb-3 leading-snug">{item.title}</h3>
              <div class="flex items-center flex-wrap gap-2.5 mb-4">
                <time class="text-[13px] text-gray-400 font-medium tracking-wide shrink-0">{item.date}</time>
                {item.isPinned && (
                  <span class="px-3 py-1 text-[11px] font-bold bg-red-50/80 text-red-600 border border-red-200 rounded-full flex items-center gap-1 shrink-0">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"></path></svg>置顶
                  </span>
                )}
                {item.category && item.category !== '未分类' && (
                  <span class={`px-3 py-1 rounded-full text-[11px] font-bold border shrink-0 ${tagTheme.capsule}`}>{item.category}</span>
                )}
              </div>
              <p class="text-sm md:text-[15px] text-gray-500/90 leading-relaxed line-clamp-5 md:line-clamp-2">{item.summary}</p>
            </div>
          </a>
        )
      })}
    </main>
  </div>
</div>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .hidden-article { display: none !important; }

  .is-glass {
    background-color: rgba(245, 245, 247, 0.6) !important;
    backdrop-filter: blur(24px) !important;
    -webkit-backdrop-filter: blur(24px) !important;
    border-bottom-color: rgba(255, 255, 255, 0.5) !important;
    box-shadow: 0 4px 30px -10px rgba(0, 0, 0, 0.08) !important;
  }

  @media (min-width: 1024px) {
    #tags-nav.is-pinned-desktop {
      position: fixed !important;
      top: 104px !important; 
      left: calc(50% + 350px) !important; 
      padding: 0 !important;
    }
    #tags-nav.is-pinned-desktop #tags-flex {
      flex-direction: column !important;
      align-items: flex-start !important;
    }
  }
</style>

<script>
  function setupFilters() {
    const filterBtns = document.querySelectorAll('.category-filter-btn');
    const articles = document.querySelectorAll('.article-card');

    if (filterBtns.length) {
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.className = `${b.dataset.baseClass} ${b.dataset.inactiveClass}`);
          btn.className = `${btn.dataset.baseClass} ${btn.dataset.activeClass}`;

          const filterValue = btn.getAttribute('data-filter');
          articles.forEach(article => {
            const articleCategory = article.getAttribute('data-article-category');
            if (filterValue === 'all' || articleCategory === filterValue) {
              article.classList.remove('hidden-article');
              article.style.opacity = '0';
              requestAnimationFrame(() => article.style.opacity = '1');
            } else {
              article.classList.add('hidden-article');
            }
          });
        });
      });
    }

    const bannerContainer = document.getElementById('banner-container');
    const sectionTitle = document.getElementById('section-title');
    const bannerBg = document.getElementById('banner-bg');
    
    if (bannerContainer && sectionTitle) {
      sectionTitle.style.willChange = 'transform';

      // 🔥 核心逻辑逆向化：从超清大图（1.0）缩小到正常字号（0.625）
      const updateTitleScale = () => {
        const rect = bannerContainer.getBoundingClientRect();
        const range = 250; 
        const distance = Math.max(0, Math.min(rect.top, range));
        const ratio = distance / range;
        
        // 当 ratio=1 (初始)，scale=1.0，显示原版超清 48px
        // 当 ratio=0 (置顶)，scale=0.625，精准缩小回约 30px (即原来的 text-3xl)
        const scale = 0.625 + (0.375 * ratio);

        sectionTitle.style.transform = `scale(${scale})`;
      };

      updateTitleScale();

      let ticking = false;
      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateTitleScale();
            ticking = false;
          });
          ticking = true;
        }
      };
      
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    const bannerSentinel = document.getElementById('banner-sentinel');
    const scrollSentinel = document.getElementById('scroll-sentinel');
    const tagsNav = document.getElementById('tags-nav');

    if (bannerSentinel && bannerBg) {
      const bannerObserver = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
          bannerBg.classList.add('is-glass');
        } else {
          bannerBg.classList.remove('is-glass');
        }
      }, { threshold: 0 });
      bannerObserver.observe(bannerSentinel);
    }

    if (scrollSentinel && tagsNav) {
      const tagsObserver = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry.isIntersecting && entry.boundingClientRect.top <= 72) {
          tagsNav.classList.add('is-pinned-desktop');
        } else {
          tagsNav.classList.remove('is-pinned-desktop');
        }
      }, { rootMargin: '-72px 0px 0px 0px', threshold: 0 });
      tagsObserver.observe(scrollSentinel);
    }
  }

  document.addEventListener('astro:page-load', setupFilters);
</script>