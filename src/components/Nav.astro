---
// src/components/Nav.astro

// 获取当前页面的 URL 路径，用于动态高亮当前所在的菜单
const currentPath = Astro.url.pathname;
// 增加首页状态的判断
const isHome = currentPath === '/' || currentPath === '/index.html';

const navLinks = [
  { name: '首页', href: '/' },
  { name: '工作履历', href: '/hero/resume' },
  { name: '实验项目', href: '/projects' },
  { name: '个人摄影集', href: '/gallery' },
  { name: '致谢', href: '/thanks' },
];
---

{/* 【修改点 1】：z-50 提升为 z-[100]，并追加 print-hide 确保打印时剔除主导航 */}
<nav id="global-nav" class="sticky top-0 z-[100] w-full bg-white/70 dark:bg-stone-900/70 backdrop-blur-md border-b border-stone-200/50 dark:border-stone-800/50 transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] print-hide">
  <div class="max-w-7xl mx-auto px-6 md:px-12 h-12 flex items-center justify-between text-xs tracking-[0.2em] uppercase font-sans relative">
    
    {/* 根据是否为首页，动态隐藏返回按钮，但保留其占位，确保 flex 布局不崩溃 */}
    <button id="back-btn" class={`text-stone-950 dark:text-white transition-opacity z-50 flex items-center ${isHome ? 'invisible pointer-events-none' : 'hover:opacity-50'}`} aria-label="返回上一页">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </button>

    <div class={`hidden md:flex items-center gap-8 ${isHome ? 'md:absolute md:left-1/2 md:-translate-x-1/2' : ''}`}>
      {navLinks.map((link) => {
        const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
        return (
          <a 
            href={link.href} 
            class={`transition-colors ${isActive ? 'text-stone-900 dark:text-stone-100 font-medium' : 'text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100'}`}
          >
            {link.name}
          </a>
        )
      })}
    </div>

    <button id="menu-toggle" class="md:hidden flex flex-col justify-center items-center w-8 h-8 z-50 focus:outline-none" aria-label="Toggle Menu">
      <span class="nav-line w-4 h-[1px] bg-stone-900 dark:bg-stone-100 transition-transform duration-300 ease-out origin-center" style="transform: translateY(-2px) rotate(0deg);"></span>
      <span class="nav-line w-4 h-[1px] bg-stone-900 dark:bg-stone-100 transition-transform duration-300 ease-out origin-center" style="transform: translateY(2px) rotate(0deg);"></span>
    </button>
  </div>
</nav>

{/* 【修改点 2】：z-40 提升为 z-[90]，并追加 print-hide 确保打印时剔除移动端菜单层 */}
<div id="mobile-menu" class="fixed inset-0 bg-white/95 dark:bg-stone-950/95 backdrop-blur-xl z-[90] md:hidden flex flex-col pt-24 px-8 gap-8 text-sm tracking-[0.25em] uppercase transition-all duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] opacity-0 pointer-events-none -translate-y-4 print-hide">
  {navLinks.map((link) => {
    const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
    return (
      <a 
        href={link.href} 
        class={`mobile-nav-link transition-all duration-300 transform translate-y-4 opacity-0 ${isActive ? 'text-stone-950 dark:text-white font-medium border-b border-stone-900 dark:border-stone-100 pb-1 self-start' : 'text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100'}`}
      >
        {link.name}
      </a>
    )
  })}
</div>

<script>
  function initBackLogic() {
    const backBtn = document.getElementById('back-btn');
    if (!backBtn) return;
    
    const newBackBtn = backBtn.cloneNode(true);
    backBtn.parentNode.replaceChild(newBackBtn, backBtn);
    
    newBackBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (window.history.length > 1 && document.referrer.includes(window.location.host)) {
        window.history.back();
      } else {
        window.location.href = '/'; 
      }
    });
  }

  function initNavbar() {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    
    if (!toggleBtn || !mobileMenu) return;

    const newToggleBtn = toggleBtn.cloneNode(true);
    toggleBtn.parentNode.replaceChild(newToggleBtn, toggleBtn);

    // 【修改点 3】：在克隆并替换节点后，再获取最新的两根横线
    const navLines = newToggleBtn.querySelectorAll('.nav-line');

    let isOpen = false;

    newToggleBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      if (isOpen) {
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
        mobileMenu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        navLines[0].style.transform = 'translateY(0.5px) rotate(45deg)';
        navLines[1].style.transform = 'translateY(-0.5px) rotate(-45deg)';
        document.body.style.overflow = 'hidden';

        mobileLinks.forEach((link, index) => {
          setTimeout(() => {
            link.classList.remove('translate-y-4', 'opacity-0');
            link.classList.add('translate-y-0', 'opacity-100');
          }, 150 + index * 50);
        });
      } else {
        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        mobileMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
        navLines[0].style.transform = 'translateY(-2px) rotate(0deg)';
        navLines[1].style.transform = 'translateY(2px) rotate(0deg)';
        document.body.style.overflow = '';

        mobileLinks.forEach(link => {
          link.classList.remove('translate-y-0', 'opacity-100');
          link.classList.add('translate-y-4', 'opacity-0');
        });
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        newToggleBtn.click();
      }
    });
  }

  function initFusionToggle() {
    const globalNav = document.getElementById('global-nav');
    if (!globalNav) return;

    const glassClasses = ['bg-white/70', 'dark:bg-stone-900/70', 'backdrop-blur-md', 'border-b', 'border-stone-200/50', 'dark:border-stone-800/50'];
    const solidClasses = ['bg-[#f5f5f7]', 'dark:bg-stone-900', 'border-transparent'];

    globalNav.classList.remove(...solidClasses);
    globalNav.classList.add(...glassClasses);

    if (!window._navFusionListenerAdded) {
      window.addEventListener('nav-fusion-toggle', (e) => {
        const nav = document.getElementById('global-nav');
        if (!nav) return;
        
        if (e.detail === 'solid') {
          nav.classList.remove(...glassClasses);
          nav.classList.add(...solidClasses);
        } else {
          nav.classList.remove(...solidClasses);
          nav.classList.add(...glassClasses);
        }
      });
      window._navFusionListenerAdded = true;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initBackLogic();
    initNavbar();
    initFusionToggle();
  });
  
  document.addEventListener('astro:page-load', () => {
    initBackLogic();
    initNavbar();
    initFusionToggle();
  });
</script>